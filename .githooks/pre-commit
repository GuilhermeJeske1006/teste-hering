#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Checagens rápidas (< 15 s) antes de cada commit: segredos, lint, tipos e testes de unidade.
# shellcheck source=_common.sh
source "$(dirname "$0")/_common.sh"

step "segredos"
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if grep -Eq '(^|/)\.env$' <<<"$staged"; then
  fail ".env não pode ser commitado (contém segredos). Use o .env.example."
fi
added="$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude)frontend/package-lock.json' | grep -E '^\+' || true)"
if grep -Eq 'sk-ant-[A-Za-z0-9_-]{20,}' <<<"$added"; then
  fail "Parece haver uma chave da Anthropic no commit. Remova e use o .env."
fi

if grep -q '^backend/' <<<"$staged"; then
  step "ruff"
  "$PY" -m ruff check backend
  step "mypy --strict (domain, application)"
  "$PY" -m mypy --strict backend/app/domain backend/app/application
  step "pytest unit"
  (cd backend && "$PY" -m pytest tests/unit -q -p no:cacheprovider)
  step "arquitetura"
  "$PY" .claude/skills/revisar-solid/scripts/check_architecture.py backend/app
fi

if grep -q '^frontend/' <<<"$staged"; then
  step "eslint"
  npm --prefix frontend run lint --silent
  step "vitest"
  npm --prefix frontend run test --silent -- --run
fi
printf '\033[1;32m✓ pre-commit ok\033[0m\n'
