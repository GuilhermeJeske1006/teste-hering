# Copie para .env (que fica fora do git) e preencha. `make run` e `make dev` carregam o .env.
# Sem ANTHROPIC_API_KEY, o sistema usa o cliente determinístico (sem rede).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Opcionais
# MESA_DB_PATH=backend/data/mesa.db
# MESA_SEED_PATH=backend/app/seed/seed.json
